  "runtime_harness": {
    "command": [
      "pnpm",
      "--dir",
      "apps/okf-explorer",
      "acceptance:bundle",
      "--",
      "--bundle-root",
      "{bundle_root}",
      "--journeys",
      "{journey_manifest}",
      "--output",
      "{receipt_path}"
