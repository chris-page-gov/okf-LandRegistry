      "evidence_core_fields": [
        "@id",
        "type",
        "url",
        "source_field",
        "source_value_sha256",
        "retrieved_at"
      ],
      "limit_validation": "bundle/data/semantic/validation.json",
      "validated_loading_paths": [
        "full-default-plane-hydration",
        "every-route-hydration"
      ]
    },
    "preserves": [
      "direction",
      "semantic-identities",
      "local-routes",
      "predicate",
      "relationship-kind",
      "preferred-and-inverse-labels",
      "assertion-status-and-scope",
      "authority",
      "derivation",
      "supporting-assertions",
      "confidence",
      "review-status",
      "evidence",
      "rights",
      "freshness",
      "lifecycle"
    ]
  },
  "relationship_contract": {
    "authoring": "generated-yaml-ld-assertion-graph",
    "direct_triple_policy": "generated-from-one-assertion-source",
    "predicate_policy": "absolute-iri",
    "required_fields": [
      "id",
      "source",
      "target",
      "source_iri",
      "target_iri",
      "predicate",
      "kind",
      "label",
      "inverse_label",
      "assertion_status",
      "assertion_scope",
      "authority",
      "derivation",
      "observed_at",
      "evidence",
      "rights"
    ],
    "schema": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/semantic-assertion.schema.json",
    "schema_binding": {
      "bytes": 7308,
      "draft": "https://json-schema.org/draft/2020-12/schema",
      "local_path": "schemas/semantic-assertion.schema.json",
      "sha256": "f69480328db4b64d678d9c50b6534d808000f7fb50a30e8cc9e3bf2facbcb8bc"
    }
  },
  "repository": {
    "name": "okf-LandRegistry",
    "role": "large-corpus-producer",
    "root_index": "bundle/index.md"
  },
  "schema": "okf-repository-semantic-contract.v1",
  "semantic_layer": {
    "authoritative_inputs": [
