        "G1": "not-run",
        "G2": "not-run",
        "G3": "not-run",
        "G4": "not-run",
        "G5": "not-run",
        "G6": "not-run",
        "G7": "not-run",
        "G8": "not-run",
        "G9": "not-run"
      },
      "release_ready": false,
      "status": "approval-neutral-candidate",
      "version": "0.3.0"
    },
    "candidate_metrics": {
      "direct_triples": 22226,
      "governed_predicates": 13,
      "reified_assertions": 22226,
      "relationship_chunks": 89,
      "route_bearing_semantic_identities": 6733,
      "route_locator_buckets": 256,
      "runtime_rows": 22226
    },
    "context_policy": "pinned-local-contexts-no-browser-remote-expansion",
    "cpsv_ap": {
      "mapping": {
        "candidates": 11,
        "evidence_references": 19,
        "excluded": 4,
