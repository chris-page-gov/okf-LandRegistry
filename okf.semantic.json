      "profile_schema_and_standard_locks": [
        "profiles/bundle-wiki/v1/",
        "profiles/bundle-wiki/v1.vendor-lock.json",
        "schemas/",
        "standards/"
      ],
      "trusted_generators_not_semantic_authority": [
        "scripts/"
      ]
    },
    "candidate_assurance": {
      "authority": "version-scoped-digest-bound-external-evidence",
      "byte_state_scope": "approval-neutral-baseline-not-current-release-state",
      "independent_review": {
