    "profile": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/",
    "serialisation_policy": "canonical-yaml-ld-equivalent-json-ld",
    "state": "generated-yaml-ld-graph-candidate"
  },
  "tooling": {
    "build": [
      ".venv/bin/python scripts/build.py --snapshot-dir source/snapshots/2026-07-29T091915Z --publication-base https://chris-page-gov.github.io/okf-LandRegistry/ --replace"
    ],
    "check": [
      ".venv/bin/python scripts/check_okf.py",
      ".venv/bin/python -m unittest tests.test_build_semantics tests.test_explorer_contract tests.test_jsonld tests.test_okf -v"
