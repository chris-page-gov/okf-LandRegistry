    "schema": "okf-explorer-large-corpus.v1",
    "id": "https://chris-page-gov.github.io/okf-LandRegistry/okf-explorer.json",
    "version": "0.3.0",
    "snapshot": "hmlr-public-metadata-v0.2.0"
  },
  "journeys": [
    {
      "id": "overview-load-and-safety",
      "actions": [
        {
          "type": "goto",
          "hash": "#overview"
        },
        {
          "type": "wait_for",
          "selector": ".topbar .title-block p:has-text(\"HM Land Registry public-estate OKF\")"
        },
        {
          "type": "wait_for",
          "selector": "main p.muted:has-text(\"not legal advice\")"
        }
      ],
      "assertions": [
        {
          "type": "text",
          "selector": "body",
          "includes": "HM Land Registry public-estate OKF"
        },
        {
          "type": "text",
          "selector": "body",
          "includes": "not legal advice"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/explorer/manifest.json"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/explorer/overview.json"
        },
        {
          "type": "not_requested",
          "includes": "/bundle/data/catalogue.json"
        },
        {
          "type": "console_clean"
        }
      ]
    },
    {
      "id": "search-and-restored-query-state",
      "actions": [
        {
          "type": "goto",
          "params": {
            "q": "exact boundary"
          }
        },
        {
          "type": "wait_for",
          "selector": "text=Exact line of boundary"
        }
      ],
      "assertions": [
        {
          "type": "text",
          "selector": "body",
          "includes": "Exact line of boundary"
        },
        {
          "type": "url_param",
          "name": "q",
          "equals": "exact boundary"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/explorer/search/manifest.json"
        },
        {
          "type": "console_clean"
        }
      ]
    },
    {
      "id": "translation-relationship",
      "actions": [
        {
          "type": "goto",
          "hash": "#dataset/record-40df4468c132c56cf31cfbc5",
          "params": {
            "view": "graph"
          }
        },
        {
          "type": "wait_for",
          "selector": "[aria-label=\"Large corpus graph\"] .edge-label:has-text(\"translation of\")"
        }
      ],
      "assertions": [
        {
          "type": "text",
          "selector": "body",
          "includes": "translation of"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/semantic/runtime-manifest.json"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/semantic/runtime/route-locator/bucket-c5.json.gz"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/semantic/runtime/core/relationships-"
        },
        {
          "type": "not_requested",
          "includes": "/bundle/data/explorer/adjacency/"
        },
        {
          "type": "console_clean"
        }
      ]
    },
    {
      "id": "deep-link-scalar-geography-and-caveat",
      "actions": [
        {
          "type": "goto",
          "hash": "#dataset/record-d40ae47538ebfbf57eff5917",
          "params": {
            "filter.geography": "Not stated by the source."
          }
        },
        {
          "type": "wait_for",
          "selector": ".right-panel h2:has-text(\"Exact line of boundary: registration (DB)\")"
        }
      ],
      "assertions": [
        {
          "type": "text",
          "selector": ".right-panel",
          "includes": "Exact line of boundary: registration (DB)"
        },
        {
          "type": "text",
          "selector": ".right-panel",
          "includes": "not a boundary conclusion"
        },
        {
          "type": "url_param",
          "name": "filter.geography",
          "equals": "Not stated by the source."
        },
        {
          "type": "url_hash",
          "equals": "#dataset/record-d40ae47538ebfbf57eff5917"
        },
        {
          "type": "console_clean"
        }
      ]
    },
    {
      "id": "selected-record-resource",
      "actions": [
        {
          "type": "goto",
          "hash": "#dataset/record-d40ae47538ebfbf57eff5917",
          "params": {
            "view": "resources"
          }
        },
        {
          "type": "wait_for",
          "selector": ".right-panel h2:has-text(\"Exact line of boundary: registration (DB)\")"
        },
        {
          "type": "click",
          "selector": ".right-panel [role=\"tab\"]:has-text(\"Evidence\")"
        },
        {
          "type": "click",
          "selector": ".right-panel details:has(summary:has-text(\"Official sources (1)\")) > summary"
        },
        {
          "type": "wait_for",
          "selector": ".right-panel .disclosure-list strong:has-text(\"Recorded public source\")"
        }
      ],
      "assertions": [
        {
          "type": "text",
          "selector": "body",
          "includes": "Recorded public source"
        },
        {
          "type": "requested",
          "includes": "/bundle/data/explorer/resources-"
        },
        {
          "type": "console_clean"
        }
      ]
    },
    {
      "id": "repeated-kind-filters",
      "actions": [
        {
          "type": "goto",
          "params": {
            "filter.kind": [
              "guidance",
              "guidance"
            ]
          }
        },
        {
          "type": "wait_for",
          "selector": "text=kind: guidance"
        }
      ],
      "assertions": [
        {
          "type": "text",
          "selector": "body",
          "includes": "kind: guidance"
        },
        {
          "type": "url_param",
          "name": "filter.kind",
          "equals": "guidance"
        },
        {
          "type": "console_clean"
        }
      ]
    }
  ]
}
