      "@id": "https://www.gov.uk/government/publications/official-copies-of-register-or-plan-registration-oc1",
      "@type": "CreativeWork",
      "dateModified": "2023-08-29T05:00:04Z",
      "description": "OC1 application form for official copies of the register, plan or certificate in Form CI. You can also buy and download a title register and title plan online.",
      "isPartOf": {
        "@id": "https://chris-page-gov.github.io/okf-LandRegistry/okf-bundle.jsonld"
